rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isValidFileSize(maxSizeMB) {
      return request.resource.size < maxSizeMB * 1024 * 1024;
    }
    
    function isValidImageType() {
      return request.resource.contentType.matches('image/.*');
    }
    
    function isValidDocumentType() {
      return request.resource.contentType.matches('application/pdf') ||
             request.resource.contentType.matches('application/msword') ||
             request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.*') ||
             request.resource.contentType.matches('text/.*');
    }

    // User avatars
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && 
                      isOwner(userId) && 
                      isValidImageType() && 
                      isValidFileSize(5);
    }

    // Organization logos
    match /organizations/{orgId}/logo/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && 
                      isValidImageType() && 
                      isValidFileSize(5);
    }

    // Project documents
    match /projects/{projectId}/documents/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && 
                      (isValidDocumentType() || isValidImageType()) && 
                      isValidFileSize(50);
    }

    // Organization documents
    match /organizations/{orgId}/documents/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && 
                      (isValidDocumentType() || isValidImageType()) && 
                      isValidFileSize(50);
    }

    // Meeting recordings and attachments
    match /meetings/{meetingId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidFileSize(500);
    }

    // Certification documents
    match /certifications/{orgId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && 
                      isValidDocumentType() && 
                      isValidFileSize(25);
    }

    // Training/certification artifacts (phone uploads). Path:
    // training-certs/{teamMemberId}/{certId}/{fileName}
    function memberOwnsPath(memberId) {
      let member = firestore.get(/databases/(default)/documents/teamMembers/$(memberId)).data;
      return member.firebaseUid == request.auth.uid ||
             member.authUid == request.auth.uid ||
             member.emailPrimary == request.auth.token.email;
    }

    function isPlatformAdmin() {
      return isAuthenticated() &&
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }

    match /training-certs/{memberId}/{certId}/{fileName} {
      allow read: if isAuthenticated() && (memberOwnsPath(memberId) || isPlatformAdmin());
      allow write: if isAuthenticated() &&
                      (memberOwnsPath(memberId) || isPlatformAdmin()) &&
                      (isValidImageType() || request.resource.contentType == 'application/pdf') &&
                      isValidFileSize(15);
    }

    // Vehicle inspection defect photos: vehicle-inspections/{inspectionId}/{fileName}
    match /vehicle-inspections/{inspectionId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidImageType() && isValidFileSize(15);
    }

    // Safety Request Box photo evidence: safety-requests/{requestId}/{fileName}
    match /safety-requests/{requestId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidImageType() && isValidFileSize(15);
    }
  }
}
